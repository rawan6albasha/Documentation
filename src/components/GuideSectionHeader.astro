---
import MdiIcon from './tracks/MdiIcon.astro';

interface Props {
  tag: string;
  title: string;
  desc?: string;
  icon?: string;
}

const { tag, title, desc, icon } = Astro.props;
---

<header class="ashara-section-header">
  <div class="ashara-section-kicker">
    {icon && <MdiIcon icon={icon} size={15} />}
    <span>{tag}</span>
  </div>
  <h2>{title}</h2>
  {desc && <p>{desc}</p>}
</header>

<style>
  .ashara-section-header {
    margin: 2.75rem 0 1.5rem;
  }

  .ashara-section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 22%, transparent);
    border-radius: 999px;
    color: var(--sl-color-text-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 9%, transparent);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .ashara-section-header h2 {
    margin: 0.8rem 0 0;
    padding: 0;
    border: 0;
    color: var(--sl-color-text-accent);
    font-size: clamp(1.45rem, 1.1rem + 1vw, 2rem);
    font-weight: 800;
    line-height: 1.45;
  }

  .ashara-section-header h2::after {
    display: block;
    width: 3.5rem;
    height: 3px;
    margin-top: 0.55rem;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--sl-color-accent), var(--sl-color-accent-high));
    content: '';
  }

  .ashara-section-header p {
    max-width: 50rem;
    margin: 0.7rem 0 0;
    color: color-mix(in srgb, var(--sl-color-text) 82%, var(--sl-color-accent));
    line-height: 1.85;
  }
</style>
