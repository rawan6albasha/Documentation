---
// School student daily workspace mock — ported from AudiencePicker.vue (audience.key === 'school').
import MdiIcon from './MdiIcon.astro';

const schoolDashboardStats = [
  {
    label: 'الواجبات',
    meta: '2 مستحقة اليوم',
    value: '4',
    valueClass: 'text-amber-600',
    icon: 'mdi-clipboard-text-outline',
    iconColor: '#F59E0B',
    cardClass: 'bg-gradient-to-br from-amber-50/80 to-amber-100/80 dark:from-amber-950/30 dark:to-amber-900/20 border-amber-200/50 dark:border-amber-800/40',
    iconWrap: 'bg-amber-100 dark:bg-amber-900/50',
    progress: '50%',
    progressTrack: 'bg-amber-200/60',
    progressBar: 'bg-amber-500',
  },
  {
    label: 'المهام',
    meta: '5 قيد التنفيذ',
    value: '5',
    valueClass: 'text-blue-600',
    icon: 'mdi-checkbox-marked-circle-outline',
    iconColor: '#3B82F6',
    cardClass: 'bg-gradient-to-br from-blue-50/80 to-blue-100/80 dark:from-blue-950/30 dark:to-blue-900/20 border-blue-200/50 dark:border-blue-800/40',
    iconWrap: 'bg-blue-100 dark:bg-blue-900/50',
    progress: '40%',
    progressTrack: 'bg-blue-200/60',
    progressBar: 'bg-blue-500',
  },
  {
    label: 'الدروس القائمة',
    meta: '3 دروس لم تُكمل',
    value: '3',
    valueClass: 'text-violet-600',
    icon: 'mdi-book-open-variant-outline',
    iconColor: '#A855F7',
    cardClass: 'bg-gradient-to-br from-purple-50/80 to-purple-100/80 dark:from-purple-950/30 dark:to-purple-900/20 border-purple-200/50 dark:border-purple-800/40',
    iconWrap: 'bg-purple-100 dark:bg-purple-900/50',
    progress: null,
    progressTrack: '',
    progressBar: '',
  },
  {
    label: 'الحضور',
    meta: '18 مؤكد · 6 متأخر',
    value: '92%',
    valueClass: 'text-emerald-700',
    icon: 'mdi-account-check-outline',
    iconColor: '#22C55E',
    cardClass: 'bg-gradient-to-br from-green-50/80 to-green-100/80 dark:from-green-950/30 dark:to-green-900/20 border-green-200/50 dark:border-green-800/40',
    iconWrap: 'bg-green-100 dark:bg-green-900/50',
    progress: '92%',
    progressTrack: 'bg-green-200/60',
    progressBar: 'bg-green-500',
  },
];

const schoolPendingTasks = [
  {
    title: 'واجب علوم: تجربة المختبر',
    meta: 'علوم · تسليم قبل 4:00 م',
    icon: 'mdi-flask-outline',
    iconClass: 'text-emerald-600',
    cardClass: 'bg-emerald-50 dark:bg-emerald-950/20 border border-emerald-200/60 dark:border-emerald-900/40',
  },
  {
    title: 'درس عربي: قراءة الفصل الثاني',
    meta: 'عربي · 15 دقيقة',
    icon: 'mdi-book-open-variant-outline',
    iconClass: 'text-sky-600',
    cardClass: 'bg-amber-200/90 dark:bg-amber-950/30',
  },
  {
    title: 'اختبار إنجليزي: Unit 4',
    meta: '10 أسئلة · غداً',
    icon: 'mdi-file-document-outline',
    iconClass: 'text-violet-600',
    cardClass: 'border border-violet-200 bg-violet-50 dark:bg-violet-950/20 dark:border-violet-900/40',
  },
];

const schoolWeekDays = [
  { key: 'sun', short: 'أحد', isToday: true },
  { key: 'mon', short: 'ثن', isToday: false },
  { key: 'tue', short: 'ثل', isToday: false },
  { key: 'wed', short: 'أرب', isToday: false },
  { key: 'thu', short: 'خم', isToday: false },
];

const scheduleCellClass = 'bg-white dark:bg-neutral-900/40 border border-neutral-200/70 dark:border-neutral-800 text-neutral-700 dark:text-neutral-300';
const scheduleLiveCellClass = 'bg-primary/[0.04] dark:bg-primary/10 border border-primary/20 dark:border-primary/25 text-neutral-800 dark:text-neutral-200';
const scheduleBreakCellClass = 'bg-neutral-100/70 dark:bg-neutral-800/25 border border-dashed border-neutral-200 dark:border-neutral-700 text-neutral-400 dark:text-neutral-500';
const scheduleBadgeClass = 'bg-neutral-100 text-neutral-600 dark:bg-neutral-800 dark:text-neutral-400';
const scheduleLiveBadgeClass = 'bg-primary/10 text-primary dark:bg-primary/15 dark:text-primary';

type Cell = { subject: string; cellClass: string; badge?: string; badgeClass?: string };
type Period = { time: string; label: string; isBreak?: boolean; cells: Record<string, Cell | undefined> };

const schoolWeeklyPeriods: Period[] = [
  {
    time: '08:00',
    label: '1',
    cells: {
      sun: { subject: 'رياضيات', cellClass: scheduleLiveCellClass, badge: 'مباشر', badgeClass: scheduleLiveBadgeClass },
      mon: { subject: 'علوم', cellClass: scheduleCellClass },
      tue: { subject: 'عربي', cellClass: scheduleCellClass },
      wed: { subject: 'رياضيات', cellClass: scheduleCellClass },
      thu: { subject: 'إنجليزي', cellClass: scheduleCellClass },
    },
  },
  {
    time: '09:00',
    label: '2',
    cells: {
      sun: { subject: 'علوم', cellClass: scheduleCellClass },
      mon: { subject: 'رياضيات', cellClass: scheduleCellClass },
      tue: { subject: 'إنجليزي', cellClass: scheduleCellClass },
      wed: { subject: 'علوم', cellClass: scheduleCellClass },
      thu: { subject: 'عربي', cellClass: scheduleCellClass },
    },
  },
  {
    time: '10:30',
    label: '3',
    cells: {
      sun: { subject: 'عربي', cellClass: scheduleCellClass },
      mon: { subject: 'إنجليزي', cellClass: scheduleCellClass, badge: 'واجب', badgeClass: scheduleBadgeClass },
      tue: { subject: 'رياضيات', cellClass: scheduleCellClass },
      wed: { subject: 'تربية', cellClass: scheduleCellClass },
      thu: { subject: 'علوم', cellClass: scheduleCellClass },
    },
  },
  {
    time: '12:00',
    label: '4',
    cells: {
      sun: { subject: 'إنجليزي', cellClass: scheduleCellClass },
      mon: { subject: 'عربي', cellClass: scheduleCellClass },
      tue: { subject: 'علوم', cellClass: scheduleCellClass },
      wed: { subject: 'إنجليزي', cellClass: scheduleCellClass },
      thu: { subject: 'رياضيات', cellClass: scheduleCellClass, badge: 'اختبار', badgeClass: scheduleBadgeClass },
    },
  },
  {
    time: '13:00',
    label: '—',
    isBreak: true,
    cells: {
      sun: { subject: 'استراحة', cellClass: scheduleBreakCellClass },
      mon: { subject: 'استراحة', cellClass: scheduleBreakCellClass },
      tue: { subject: 'استراحة', cellClass: scheduleBreakCellClass },
      wed: { subject: 'استراحة', cellClass: scheduleBreakCellClass },
      thu: { subject: 'استراحة', cellClass: scheduleBreakCellClass },
    },
  },
];
---
<div class="relative rounded-3xl p-1 bg-white/60 dark:bg-white/[0.03] border border-white/40 dark:border-white/5 shadow-2xl">
  <div class="flex items-center justify-between px-4 py-3 border-b border-neutral-200/50 dark:border-neutral-800/40 bg-white/50 dark:bg-neutral-900/30 rounded-t-[22px]">
    <div class="flex gap-1.5">
      <span class="h-3 w-3 rounded-full bg-rose-500/80" />
      <span class="h-3 w-3 rounded-full bg-amber-500/80" />
      <span class="h-3 w-3 rounded-full bg-emerald-500/80" />
    </div>
    <div class="w-2/3 max-w-sm h-7 rounded-lg bg-neutral-200/50 dark:bg-neutral-800/40 border border-neutral-300/30 dark:border-neutral-700/30 flex items-center justify-center gap-1.5 px-3">
      <MdiIcon icon="mdi-lock" size={12} class="text-emerald-500" />
      <span class="text-[10px] text-neutral-500 dark:text-neutral-400 font-mono" dir="ltr">10ashara.com/school/student</span>
    </div>
    <div class="flex items-center gap-2 text-neutral-400">
      <MdiIcon icon="mdi-reload" size={14} />
    </div>
  </div>

  <div class="relative flex flex-col flex-1 bg-neutral-100/80 dark:bg-neutral-950 rounded-b-[22px] overflow-hidden text-[10px]">
    <div class="flex items-center justify-between px-3 py-2 bg-white dark:bg-neutral-900 border-b border-neutral-200 dark:border-neutral-800/80 gap-2">
      <div class="flex items-center gap-2 min-w-0">
        <span class="text-[12px] font-black text-teal-700 dark:text-teal-400 shrink-0">عشرة</span>
        <div class="h-5 w-px bg-neutral-200 dark:bg-neutral-800 shrink-0" />
        <h4 class="text-[7.5px] font-bold text-neutral-800 dark:text-neutral-200 truncate max-w-[150px]">
          مساحة الصف اليومية · الصف السابع
        </h4>
      </div>
      <div class="flex items-center gap-1 px-2.5 py-1 bg-teal-50 dark:bg-teal-950/30 text-teal-800 dark:text-teal-300 border border-teal-200/60 dark:border-teal-900/40 rounded-lg max-w-[200px]">
        <MdiIcon icon="mdi-format-quote-open" size={9} class="text-teal-600 shrink-0" />
        <span class="text-[7px] font-medium truncate">ابدأ يومك بذكر الله؛ يُبارك وقتك</span>
        <MdiIcon icon="mdi-format-quote-close" size={9} class="text-teal-600 shrink-0" />
      </div>
      <div class="flex items-center gap-1 shrink-0">
        <button type="button" class="flex items-center gap-0.5 px-2 py-1 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 text-[7.5px] font-bold text-neutral-700 dark:text-neutral-300">
          <MdiIcon icon="mdi-book-open-variant-outline" size={10} />
          <span>موادي</span>
        </button>
        <button type="button" class="relative w-6 h-6 flex items-center justify-center rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 text-neutral-500">
          <MdiIcon icon="mdi-bell-outline" size={10} />
          <span class="absolute -top-0.5 -start-0.5 w-3 h-3 bg-teal-600 text-white rounded-full flex items-center justify-center text-[6px] font-bold">3</span>
        </button>
        <div class="w-6 h-6 flex items-center justify-center rounded-lg bg-teal-700 text-white font-black text-[9px]">س</div>
      </div>
    </div>

    <div class="p-2 flex gap-2 flex-1 relative">
      <div class="w-11 shrink-0 flex flex-col gap-1.5">
        <div class="rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 shadow-sm flex items-center justify-center py-2">
          <div class="w-7 h-7 rounded-full bg-teal-700 text-white flex items-center justify-center font-black text-[9px]">س</div>
        </div>
        <div class="flex-1 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 shadow-sm flex flex-col items-center py-1.5 gap-0.5">
          <div class="w-8 h-8 rounded-lg bg-teal-800 text-white flex items-center justify-center shadow-sm">
            <MdiIcon icon="mdi-school-outline" size={14} />
          </div>
          <div class="w-8 h-8 rounded-lg text-neutral-500 flex items-center justify-center">
            <MdiIcon icon="mdi-book-open-variant-outline" size={14} />
          </div>
          <div class="w-8 h-8 rounded-lg text-neutral-500 flex items-center justify-center">
            <MdiIcon icon="mdi-checkbox-marked-circle-outline" size={14} />
          </div>
          <div class="w-8 h-8 rounded-lg text-neutral-500 flex items-center justify-center">
            <MdiIcon icon="mdi-calendar-month-outline" size={14} />
          </div>
          <div class="w-8 h-8 rounded-lg text-neutral-500 flex items-center justify-center">
            <MdiIcon icon="mdi-account-supervisor-outline" size={14} />
          </div>
        </div>
        <div class="rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 shadow-sm flex items-center justify-center py-1.5 text-neutral-500">
          <MdiIcon icon="mdi-chevron-left" size={14} />
        </div>
      </div>

      <div class="flex-1 min-w-0 flex flex-col gap-2 min-h-0">
        <div class="grid grid-cols-[1fr_1.15fr] gap-2">
          <div class="relative rounded-[14px] overflow-hidden bg-[#1a1d24] border border-rose-500/20 shadow-md min-h-[96px]">
            <div class="absolute inset-0 pointer-events-none opacity-50" aria-hidden="true">
              <div class="absolute -top-6 start-0 h-20 w-20 rounded-full bg-rose-500/25 blur-2xl" />
              <div class="absolute bottom-0 end-0 h-16 w-16 rounded-full bg-teal-500/15 blur-xl" />
            </div>
            <div class="relative z-10 p-2 h-full flex flex-col justify-between">
              <div class="flex items-center justify-between gap-1">
                <span class="inline-flex items-center gap-0.5 rounded-md bg-rose-600 px-1.5 py-0.5 text-[6px] font-black text-white">
                  <span class="relative flex h-1.5 w-1.5">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-white/70 opacity-75" />
                    <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-white" />
                  </span>
                  مباشر
                </span>
                <span class="font-mono text-[7.5px] font-bold text-rose-400 tabular-nums">48:12</span>
              </div>
              <div class="flex items-center gap-2 mt-1">
                <div class="relative shrink-0">
                  <div class="h-9 w-9 rounded-full bg-neutral-700 flex items-center justify-center border border-teal-400/40">
                    <MdiIcon icon="mdi-account-tie" size={16} class="text-white/90" />
                  </div>
                  <span class="absolute -bottom-0.5 -end-0.5 h-2.5 w-2.5 rounded-full bg-emerald-500 border border-[#1a1d24] flex items-center justify-center">
                    <MdiIcon icon="mdi-microphone" size={5} class="text-white" />
                  </span>
                </div>
                <div class="min-w-0 flex-1">
                  <p class="text-[7px] font-bold text-white truncate">أ. خالد · رياضيات</p>
                  <p class="text-[5.5px] text-white/45 truncate">المعادلات الخطية · الحصة 1</p>
                  <div class="flex items-center gap-1 mt-1">
                    <span class="inline-flex items-center gap-0.5 text-[5.5px] text-white/60">
                      <MdiIcon icon="mdi-account-group-outline" size={8} />
                      24 حاضر
                    </span>
                    <span class="h-3 w-px bg-white/10" />
                    <span class="text-[5.5px] text-emerald-400 font-bold">يُسجّل</span>
                  </div>
                </div>
              </div>
              <div class="flex items-center justify-between gap-1 mt-1.5 pt-1 border-t border-white/5">
                <button type="button" class="inline-flex items-center gap-0.5 rounded-full bg-rose-600 px-2 py-0.5 text-[6px] font-black text-white cursor-default">
                  <MdiIcon icon="mdi-video" size={9} />
                  انضم
                </button>
                <div class="flex items-center gap-0.5">
                  <span class="h-5 w-5 rounded-full bg-white/5 border border-white/10 flex items-center justify-center">
                    <MdiIcon icon="mdi-hand-back-right" size={8} class="text-amber-400" />
                  </span>
                  <span class="h-5 w-5 rounded-full bg-white/5 border border-white/10 flex items-center justify-center">
                    <MdiIcon icon="mdi-chat-outline" size={8} class="text-white/70" />
                  </span>
                </div>
              </div>
            </div>
          </div>

          <div class="relative rounded-[14px] overflow-hidden shadow-md min-h-[96px] bg-gradient-to-br from-teal-900 to-teal-700 text-white">
            <div class="absolute inset-0 opacity-20 pointer-events-none" aria-hidden="true">
              <div class="absolute -top-6 -end-6 w-24 h-24 rounded-full bg-white blur-2xl" />
              <div class="absolute bottom-0 start-0 w-16 h-16 rounded-full bg-rose-400 blur-2xl" />
            </div>
            <div class="relative z-10 p-2.5 h-full flex flex-col justify-between">
              <div>
                <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full bg-white/30 border border-white/20 text-[6px] font-medium text-white/90">
                  <span class="w-1 h-1 rounded-full bg-green-400 animate-pulse" />
                  الصف السابع · شعبة أ
                </span>
                <h2 class="text-[10px] font-bold mt-1 leading-tight">مساء الخير، سارة! 👋</h2>
                <p class="text-[6px] text-white/70 mt-0.5 leading-relaxed">
                  لديك حصة مباشرة الآن و3 مهام قبل نهاية اليوم
                </p>
              </div>
              <div class="flex items-center gap-2 text-[6.5px] text-white/90 mt-1">
                <span class="flex items-center gap-0.5 font-medium">
                  <MdiIcon icon="mdi-check-circle" size={8} class="opacity-80" />
                  2 مكتملة
                </span>
                <span class="w-px h-3 bg-white/20" />
                <span class="flex items-center gap-0.5 font-medium">
                  <MdiIcon icon="mdi-clock-outline" size={8} class="opacity-80" />
                  5 قيد التقدم
                </span>
                <span class="w-px h-3 bg-white/20" />
                <span class="flex items-center gap-0.5 font-medium">
                  <MdiIcon icon="mdi-account-check-outline" size={8} class="opacity-80" />
                  حضور 92%
                </span>
              </div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-4 gap-1.5">
          {schoolDashboardStats.map((stat) => (
            <div class:list={['relative rounded-[12px] border p-2 min-h-[68px] overflow-hidden shadow-sm', stat.cardClass]}>
              <div class="flex items-center gap-1">
                <div class:list={['p-1 rounded-md', stat.iconWrap]}>
                  <MdiIcon icon={stat.icon} size={10} style={`color:${stat.iconColor}`} />
                </div>
                <span class="text-[6.5px] font-bold text-neutral-800 dark:text-neutral-100 leading-tight">{stat.label}</span>
              </div>
              <div class="mt-1.5 flex items-end justify-between gap-1">
                <span class="text-[5.5px] text-neutral-500 leading-tight">{stat.meta}</span>
                <span class:list={['text-[13px] font-black leading-none', stat.valueClass]}>{stat.value}</span>
              </div>
              {stat.progress && (
                <div class:list={['absolute bottom-0 inset-x-0 h-1', stat.progressTrack]}>
                  <div class:list={['h-full', stat.progressBar]} style={`width:${stat.progress}`} />
                </div>
              )}
            </div>
          ))}
        </div>

        <div class="flex-1 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 shadow-sm p-2.5 grid grid-cols-2 gap-2.5 min-h-[250px] items-stretch">
          <div class="min-w-0 flex flex-col min-h-0 h-full">
            <h4 class="text-[9px] font-bold text-neutral-900 dark:text-white px-1 pb-1 shrink-0">
              دروس ومهام اليوم
              <span class="font-normal text-neutral-500 ms-1">({schoolPendingTasks.length + 1})</span>
            </h4>
            <div class="border-t border-neutral-100 dark:border-neutral-800 pt-1.5 space-y-1.5 flex-1 min-h-0 flex flex-col">
              <div class="flex items-center justify-between px-1.5 py-1 rounded-md bg-rose-50 dark:bg-rose-950/30 text-[7px] font-bold text-rose-800 dark:text-rose-300 border border-rose-200/60 dark:border-rose-900/40 shrink-0">
                <span class="truncate flex items-center gap-1">
                  <span class="h-1.5 w-1.5 rounded-full bg-rose-500 animate-pulse shrink-0" />
                  رياضيات · حصة مباشرة الآن
                </span>
                <MdiIcon icon="mdi-broadcast" size={10} class="text-rose-500 shrink-0" />
              </div>
              <div class="flex-1 min-h-0 space-y-1.5 overflow-hidden">
                {schoolPendingTasks.map((task) => (
                  <div class:list={['rounded-lg px-2.5 py-2 flex items-start gap-1.5 shadow-sm min-h-[34px]', task.cardClass]}>
                    <div class="flex-1 min-w-0">
                      <p class="text-[7px] font-bold text-neutral-900 dark:text-neutral-100 leading-snug">{task.title}</p>
                      <p class="text-[5.5px] text-neutral-600/70 dark:text-neutral-400 mt-0.5">{task.meta}</p>
                    </div>
                    <MdiIcon icon={task.icon} size={10} class={`shrink-0 mt-0.5 ${task.iconClass}`} />
                  </div>
                ))}
              </div>
              <div class="rounded-lg border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-950/30 px-2.5 py-1.5 flex items-center justify-between text-[6.5px] font-bold text-neutral-700 dark:text-neutral-300 shrink-0 mt-auto">
                <span>مهام غير إلزامية</span>
                <MdiIcon icon="mdi-chevron-down" size={10} class="text-neutral-400" />
              </div>
            </div>
          </div>

          <div class="min-w-0 flex flex-col min-h-0 h-full">
            <div class="flex items-start justify-between px-1 pb-1 shrink-0">
              <h4 class="text-[9px] font-bold text-neutral-900 dark:text-white">
                الجدول الأسبوعي
                <span class="font-normal text-neutral-500 ms-1">الصف السابع</span>
              </h4>
              <span class="text-[6px] font-bold text-neutral-500 dark:text-neutral-400">13–17 يوليو</span>
            </div>
            <div class="border-t border-neutral-100 dark:border-neutral-800 pt-1.5 flex-1 min-h-0 flex flex-col">
              <div class="flex-1 min-h-0 overflow-hidden rounded-lg border border-neutral-200 dark:border-neutral-800">
                <table class="ap-weekly-calendar w-full h-full border-collapse text-[5.5px]">
                  <thead>
                    <tr class="bg-neutral-50 dark:bg-neutral-950/70 border-b border-neutral-200 dark:border-neutral-800">
                      <th class="px-1 py-1.5 text-center font-bold text-neutral-500 dark:text-neutral-400 w-[22px]">#</th>
                      <th class="px-1 py-1.5 text-center font-bold text-neutral-500 dark:text-neutral-400 w-[26px]">الوقت</th>
                      {schoolWeekDays.map((day) => (
                        <th
                          class:list={[
                            'px-0.5 py-1.5 text-center font-bold whitespace-nowrap',
                            day.isToday
                              ? 'bg-neutral-100/80 dark:bg-neutral-800/50 text-neutral-800 dark:text-neutral-200'
                              : 'text-neutral-500 dark:text-neutral-400',
                          ]}
                        >
                          <span class="block">{day.short}</span>
                          {day.isToday && <span class="block text-[4.5px] font-black text-primary mt-0.5">اليوم</span>}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {schoolWeeklyPeriods.map((period) => (
                      <tr
                        class:list={[
                          'border-b border-neutral-100 dark:border-neutral-800/80 last:border-b-0',
                          period.isBreak ? 'bg-neutral-100/70 dark:bg-neutral-950/30' : '',
                        ]}
                      >
                        <td class="px-1 py-1 align-middle text-center text-neutral-400 font-bold">
                          {period.label}
                        </td>
                        <td class="px-1 py-1 align-middle text-center whitespace-nowrap">
                          <span class="font-black tabular-nums text-neutral-600 dark:text-neutral-300">{period.time}</span>
                        </td>
                        {schoolWeekDays.map((day) => {
                          const cell = period.cells[day.key];
                          return (
                            <td class:list={['px-0.5 py-1 align-middle text-center', day.isToday ? 'bg-neutral-50/80 dark:bg-neutral-900/30' : '']}>
                              {cell ? (
                                <div class:list={['rounded px-0.5 py-1 min-h-[22px] flex flex-col items-center justify-center gap-0.5 leading-tight', cell.cellClass]}>
                                  <span class="font-bold truncate max-w-full">{cell.subject}</span>
                                  {cell.badge && (
                                    <span class:list={['inline-flex rounded px-1 py-px text-[4.5px] font-black whitespace-nowrap', cell.badgeClass]}>
                                      {cell.badge}
                                    </span>
                                  )}
                                </div>
                              ) : (
                                <span class="text-neutral-300 dark:text-neutral-600">—</span>
                              )}
                            </td>
                          );
                        })}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>

