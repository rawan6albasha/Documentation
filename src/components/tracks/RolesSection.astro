---
// "اختر حسب دورك" — calm feature-style cards: soft tinted border, pale icon tile, title + description.
import MdiIcon from './MdiIcon.astro';
import SectionHeader from './SectionHeader.astro';

interface Role {
  href: string;
  icon: string;
  title: string;
  desc: string;
}

const roles: Role[] = [
  {
    href: '/ar/getting-started/site-settings',
    icon: 'mdi-shield-account-outline',
    title: 'مسؤول نظام / إدارة',
    desc: 'تهيئة المنصة، الإعدادات المالية، إدارة المستخدمين، المبيعات، والتقارير.',
  },
  {
    href: '/ar/getting-started/currenciescountriescities',
    icon: 'mdi-human-male-board',
    title: 'معلّم / مدرب',
    desc: 'إنشاء الدورات والمحتوى، أدوات الذكاء الاصطناعي، والاختبارات وتصحيحها.',
  },
  {
    href: '/ar/getting-started/currenciescountriescities',
    icon: 'mdi-account-school-outline',
    title: 'طالب / ولي أمر',
    desc: 'التعلّم، متابعة الحضور والتقدم، الاطلاع على التقارير، ومتابعة الأبناء.',
  },
];
---

<section class="ap-roles not-content relative">
  <SectionHeader
    id="roles"
    tag="دليل التوجيه السريع"
    title="من أين تبدأ؟ اختر حسب دورك"
    desc="وصول مباشر إلى الأدلة والتعليمات التي تهمّك."
  />

  <div class="grid gap-6 pb-10 md:grid-cols-3 md:gap-8">
    {roles.map((role, index) => (
      <a href={role.href} class="ap-role group no-underline" style={`--track-delay:${120 + index * 90}ms`}>
        <span class="ap-role-icon">
          <MdiIcon icon={role.icon} size={26} />
        </span>
        <h3 class="ap-role-title">{role.title}</h3>
        <p class="ap-role-desc">{role.desc}</p>
      </a>
    ))}
  </div>
</section>

<style>
  .ap-roles {
    margin-top: 4rem;
  }

  .ap-role {
    --role-border: #cfe3dc;
    --role-tile: #e8f2ee;
    --role-icon: #3f8f78;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 2.5rem 2.25rem 2.25rem;
    border: 2px solid var(--role-border);
    border-radius: 2.25rem;
    background: linear-gradient(160deg, #ffffff 0%, #fbfcfc 45%, #f1f6f4 100%);
    color: inherit;
    text-decoration: none;
    transition: border-color 300ms ease, background 300ms ease, transform 300ms ease;
    opacity: 0;
    transform: translateY(24px);
    animation: ap-role-in 800ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--track-delay, 0ms);
  }

  .ap-role:hover,
  .ap-role:focus-visible {
    --role-border: #bdbdbd;
    --role-tile: #ececec;
    --role-icon: #262626;
    background: linear-gradient(160deg, #ffffff 0%, #f7f7f7 50%, #efefef 100%);
  }

  .ap-role-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 1.25rem;
    background: var(--role-tile);
    color: var(--role-icon);
    transition: background 300ms ease, color 300ms ease;
  }

  .ap-role-title {
    margin: 3rem 0 0;
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.4;
    color: #171717;
  }

  .ap-role-desc {
    margin: 1.25rem 0 0;
    font-size: 1.05rem;
    line-height: 1.8;
    color: #525252;
  }

  :global([data-theme='dark']) .ap-role {
    --role-border: rgba(94, 160, 139, 0.28);
    --role-tile: rgba(94, 160, 139, 0.14);
    --role-icon: #7cc7ad;
    background: linear-gradient(160deg, #111816 0%, #0e1412 55%, #0b100f 100%);
  }

  :global([data-theme='dark']) .ap-role:hover,
  :global([data-theme='dark']) .ap-role:focus-visible {
    --role-border: rgba(255, 255, 255, 0.22);
    --role-tile: rgba(255, 255, 255, 0.08);
    --role-icon: #f5f5f5;
    background: linear-gradient(160deg, #171717 0%, #121212 55%, #0e0e0e 100%);
  }

  :global([data-theme='dark']) .ap-role-title {
    color: #fafafa;
  }

  :global([data-theme='dark']) .ap-role-desc {
    color: #a3a3a3;
  }

  @keyframes ap-role-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 50rem) {
    .ap-role {
      padding: 2rem 1.75rem 1.75rem;
      border-radius: 1.75rem;
    }
    .ap-role-title {
      margin-top: 2rem;
      font-size: 1.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ap-role {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
  }
</style>
